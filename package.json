{
  "name": "2d-ninja-slash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "node build/index.js",
    "start:server": "node build/index.js",
    "build": "npm run build:server",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build:web": "npm run typecheck && vite build",
    "build:game": "npm run typecheck && vite build --mode game",
    "android:sync": "npm run build:game && npx cap sync android",
    "android:run": "npm run build:game && npx cap sync android && npx cap run android",
    "android:open": "npm run build:game && npx cap sync android && npx cap open android",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@colyseus/schema": "^4.0.26",
    "@colyseus/sdk": "^0.17.42",
    "@fontsource/shojumaru": "^5.2.8",
    "colyseus": "^0.17.10",
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
